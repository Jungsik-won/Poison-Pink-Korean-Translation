{
  "s02": [
    {
      "start": 31.01,
      "end": 32.69,
      "source": "やっと見つけたわ。",
      "text": "드디어 찾았네."
    },
    {
      "start": 36.93,
      "end": 38.69,
      "source": "テージ、気をつけろ。",
      "text": "테이지, 조심해."
    },
    {
      "start": 39.09,
      "end": 41.25,
      "source": "魔神の気配が近い。",
      "text": "가까이서 마신의 기척이 느껴져."
    },
    {
      "start": 41.65,
      "end": 43.0,
      "source": "ラキ。",
      "text": "라키."
    },
    {
      "start": 62.2,
      "end": 63.4,
      "source": "待ちなさい。",
      "text": "기다려."
    },
    {
      "start": 70.12,
      "end": 73.4,
      "source": "悪趣味ね。",
      "text": "정말 악취미네."
    },
    {
      "start": 90.77,
      "end": 92.1,
      "source": "それじゃ、",
      "text": "그럼…"
    },
    {
      "start": 94.05,
      "end": 96.8,
      "source": "目障りだから消えてちょうだい。",
      "text": "눈에 거슬리니까 사라져 줘."
    }
  ],
  "s03": [
    {
      "start": 22.45,
      "end": 26.3,
      "source": "テージ。",
      "text": "테이지…"
    },
    {
      "start": 33.38,
      "end": 34.7,
      "source": "ラキ？",
      "text": "라키?"
    },
    {
      "start": 40.1,
      "end": 42.0,
      "source": "来たか。",
      "text": "왔나."
    }
  ],
  "s04": [
    {
      "start": 0.65,
      "end": 5.4,
      "source": "人と魔と精霊が存在していた時代…",
      "text": "인간과 마신, 정령이 존재하던 시대…"
    },
    {
      "start": 7.0,
      "end": 9.0,
      "source": "聖バルダミアン王国は",
      "text": "성 바르다미안 왕국은"
    },
    {
      "start": 9.0,
      "end": 11.2,
      "source": "サンディークス大陸の一帯を、",
      "text": "산디크스 대륙 일대를"
    },
    {
      "start": 11.2,
      "end": 14.5,
      "source": "1400年の長きに渡り統治してきた",
      "text": "1,400년이라는 긴 세월 동안 다스려 왔다."
    },
    {
      "start": 15.1,
      "end": 21.35,
      "source": "女神アトーナを信奉する聖バルド教を国教とし",
      "text": "여신 아토나를 섬기는\n성 발드교를 국교로 삼아,"
    },
    {
      "start": 22.0,
      "end": 26.3,
      "source": "異なる宗教、民族との争いに勝利してきたこの国には、",
      "text": "다른 종교와 민족과의 싸움에서\n승리를 거듭해 온 이 나라에는"
    },
    {
      "start": 27.0,
      "end": 32.0,
      "source": "万世一系の王家と、騎士団があった",
      "text": "대대로 혈통을 이어 온 왕가와 기사단이 있었다."
    },
    {
      "start": 32.0,
      "end": 35.0,
      "source": "バルド王家、そして",
      "text": "발드 왕가, 그리고"
    },
    {
      "start": 35.0,
      "end": 38.3,
      "source": "聖バルダミアン王国騎士団である",
      "text": "성 바르다미안 왕국 기사단이다."
    },
    {
      "start": 39.0,
      "end": 43.7,
      "source": "古くから騎士団長は、王家に入る習わしがあった",
      "text": "예로부터 기사단장은\n왕가의 사위가 되는 관습이 있었다."
    },
    {
      "start": 44.1,
      "end": 48.0,
      "source": "若き団長オリフェンと、ルナーシェ姫の婚約が間近に迫ったある日",
      "text": "젊은 기사단장 오리펜과 루나셰 공주의"
    },
    {
      "start": 48.0,
      "end": 51.0,
      "source": "若き団長オリフェンと、ルナーシェ姫の婚約が間近に迫ったある日",
      "text": "약혼을 앞둔 어느 날,"
    },
    {
      "start": 51.1,
      "end": 54.1,
      "source": "姫が忽然と姿を消す",
      "text": "공주가 홀연히 자취를 감춘다."
    },
    {
      "start": 55.1,
      "end": 58.2,
      "source": "時を同じくして、王国の辺境に現れた",
      "text": "그와 동시에 왕국의 변방에 나타난"
    },
    {
      "start": 59.0,
      "end": 61.3,
      "source": "獄界ベセク",
      "text": "옥계 베세크."
    },
    {
      "start": 62.1,
      "end": 66.0,
      "source": "不安と恐怖が国中を駆けめぐり",
      "text": "불안과 공포가 온 나라를 휩쓸고,"
    },
    {
      "start": 66.4,
      "end": 69.2,
      "source": "評議会が明確な決断を出せぬ中、",
      "text": "평의회가 뚜렷한 결정을 내리지 못하는 가운데"
    },
    {
      "start": 70.1,
      "end": 74.8,
      "source": "聖バルド王は、驚くべき声明を発表する",
      "text": "성 발드 왕은 놀라운 성명을 발표한다."
    },
    {
      "start": 75.9,
      "end": 79.8,
      "source": "古き聖典に記された凶兆の証、",
      "text": "옛 경전에 기록된 흉조의 증거,"
    },
    {
      "start": 80.25,
      "end": 83.7,
      "source": "獄界ベセクがこの世に顕現した。",
      "text": "옥계 베세크가 이 세상에 나타났다."
    },
    {
      "start": 84.5,
      "end": 89.7,
      "source": "世界は今、邪神の権化たる魔神どもの侵略により、",
      "text": "세계는 지금 사신의 화신인\n마신들의 침략으로"
    },
    {
      "start": 89.9,
      "end": 93.8,
      "source": "混沌の世界へと塗り替えられようとしている。",
      "text": "혼돈에 뒤덮이려 하고 있다."
    },
    {
      "start": 94.15,
      "end": 97.35,
      "source": "そして我らが姫ルナーシェ。",
      "text": "그리고 우리의 공주, 루나셰."
    },
    {
      "start": 98.15,
      "end": 101.8,
      "source": "姫は、卑しき魔神の巣窟である",
      "text": "공주는 천한 마신들의 소굴인"
    },
    {
      "start": 102.1,
      "end": 104.8,
      "source": "獄界ベセクに囚われてしまった。",
      "text": "옥계 베세크에 사로잡히고 말았다."
    },
    {
      "start": 105.2,
      "end": 109.3,
      "source": "身分、民族、信仰の何事も問わぬ。",
      "text": "신분도, 민족도, 신앙도 묻지 않겠다."
    },
    {
      "start": 109.4,
      "end": 113.7,
      "source": "獄界ベセクに囚われし姫を救い出せ。",
      "text": "옥계 베세크에 사로잡힌 공주를 구하라."
    },
    {
      "start": 114.0,
      "end": 118.15,
      "source": "さすれば、望みの褒美を与えよう。",
      "text": "그리하면 원하는 포상을 내리겠다."
    }
  ],
  "s05": [
    {
      "start": 7.76,
      "end": 9.1,
      "source": "ここだ。",
      "text": "여기다."
    },
    {
      "start": 12.72,
      "end": 14.5,
      "source": "ええ。",
      "text": "그래."
    },
    {
      "start": 19.45,
      "end": 23.1,
      "source": "ここが、獄界ベセク。",
      "text": "여기가 옥계 베세크…"
    }
  ],
  "s06": [
    {
      "start": 14.58,
      "end": 16.25,
      "source": "待て、オリフェン！",
      "text": "기다려, 오리펜!"
    },
    {
      "start": 21.46,
      "end": 23.5,
      "source": "落ち着け！",
      "text": "진정해!"
    },
    {
      "start": 25.7,
      "end": 29.0,
      "source": "これが、落ち着いていられる状況か！",
      "text": "이 상황에 진정하게 생겼나!"
    },
    {
      "start": 30.58,
      "end": 32.3,
      "source": "オリフェン…",
      "text": "오리펜…"
    },
    {
      "start": 34.7,
      "end": 36.3,
      "source": "わかっている。",
      "text": "알고 있어."
    },
    {
      "start": 48.69,
      "end": 52.1,
      "source": "あなたは…デュファストン侯爵？",
      "text": "당신은… 듀파스톤 후작?"
    },
    {
      "start": 53.01,
      "end": 57.1,
      "source": "ベセクへ向かうのなら、この本が必要でしょう。",
      "text": "베세크로 가려면 이 책이 필요할 겁니다."
    },
    {
      "start": 57.2,
      "end": 60.2,
      "source": "オリフェン騎士団長。",
      "text": "오리펜 기사단장."
    },
    {
      "start": 61.7,
      "end": 65.2,
      "source": "これは、古の大魔道師が",
      "text": "이것이 옛 대마도사가"
    },
    {
      "start": 65.25,
      "end": 69.1,
      "source": "魔神を封じるために作った本、と言ったら",
      "text": "마신을 봉인하려고 만든 책이라고 하면,"
    },
    {
      "start": 69.15,
      "end": 72.6,
      "source": "あなたはどうするかな？",
      "text": "어떻게 하시겠습니까?"
    }
  ],
  "s07": [
    {
      "start": 23.33,
      "end": 26.2,
      "source": "これは古の大魔道師が",
      "text": "이것은 옛 대마도사가"
    },
    {
      "start": 26.25,
      "end": 30.35,
      "source": "魔神を封じるために作った本と言われています。",
      "text": "마신을 봉인하려고 만든 책이라고 합니다."
    },
    {
      "start": 31.4,
      "end": 36.3,
      "source": "きっと、あなたの冒険の役に立つことでしょう。",
      "text": "분명 당신의 모험에 도움이 될 겁니다."
    },
    {
      "start": 45.0,
      "end": 49.4,
      "source": "魔神を封じる…",
      "text": "마신을 봉인한다…"
    }
  ],
  "s08": [
    {
      "start": 17.01,
      "end": 20.8,
      "source": "次に会う時が最後だ。",
      "text": "다음에 만날 때가 마지막이다."
    }
  ],
  "s09": [
    {
      "start": 1.84,
      "end": 5.6,
      "source": "女神を愛そうとした愚かな王は",
      "text": "여신을 사랑하려 했던 어리석은 왕은"
    },
    {
      "start": 6.48,
      "end": 11.3,
      "source": "ベセクを利用し、最愛の女神を生み出そうとした。",
      "text": "베세크를 이용해\n사랑하는 여신을 탄생시키려 했다."
    },
    {
      "start": 12.56,
      "end": 18.6,
      "source": "だが幾度も失敗し、その都度、時の流転を繰り返した。",
      "text": "하지만 번번이 실패했고,\n그때마다 시간의 흐름을 되풀이했다."
    },
    {
      "start": 19.88,
      "end": 22.15,
      "source": "しかし今、我が手には",
      "text": "그러나 지금 내 손에는"
    },
    {
      "start": 22.36,
      "end": 26.15,
      "source": "介入者の手により真の力を得た",
      "text": "개입자의 손을 거쳐 진정한 힘을 얻은"
    },
    {
      "start": 27.08,
      "end": 30.0,
      "source": "この書がある。",
      "text": "이 책이 있다."
    },
    {
      "start": 36.2,
      "end": 39.5,
      "source": "リベル・アウローラ。",
      "text": "리벨 아우로라."
    },
    {
      "start": 40.93,
      "end": 44.0,
      "source": "真の覚醒を遂げし書よ、",
      "text": "진정한 각성을 이룬 책이여,"
    },
    {
      "start": 44.05,
      "end": 49.2,
      "source": "〔修飾部は聞き取り不確実〕道を開きたまえ！",
      "text": "길을 열어라!"
    }
  ],
  "s10": [
    {
      "start": 14.32,
      "end": 20.25,
      "source": "深い眠りの中で",
      "text": "깊은 잠 속에서"
    },
    {
      "start": 20.35,
      "end": 26.2,
      "source": "消えた光 導く",
      "text": "사라진 빛을 이끌어"
    },
    {
      "start": 26.32,
      "end": 32.15,
      "source": "絡みついた夢たちが",
      "text": "휘감긴 꿈들이"
    },
    {
      "start": 32.25,
      "end": 38.15,
      "source": "誘いささやく",
      "text": "속삭이며 나를 불러"
    },
    {
      "start": 38.28,
      "end": 44.35,
      "source": "胸の奥の",
      "text": "마음 깊은 곳에"
    },
    {
      "start": 44.45,
      "end": 55.8,
      "source": "忘れぬこの痛みに〔後続の歌唱語は未確定〕",
      "text": "잊히지 않는 이 아픔"
    },
    {
      "start": 56.32,
      "end": 61.82,
      "source": "消えかけた真実に",
      "text": "사라져 가는 진실에"
    },
    {
      "start": 63.02,
      "end": 68.35,
      "source": "張り詰めたこの身をどうか",
      "text": "팽팽히 긴장한 이 몸을 부디"
    },
    {
      "start": 68.46,
      "end": 74.9,
      "source": "あなたの指でほどいて",
      "text": "그대의 손끝으로 풀어 줘"
    },
    {
      "start": 75.04,
      "end": 80.4,
      "source": "焼けついたこの言葉を",
      "text": "깊이 새겨진 이 말을"
    },
    {
      "start": 80.5,
      "end": 86.0,
      "source": "遮って 壊して〔遮ってはASR表記さえ切ってを文脈補正〕",
      "text": "가로막고 부숴 줘"
    },
    {
      "start": 86.1,
      "end": 93.3,
      "source": "溶けてゆくわ 幻と",
      "text": "환상과 함께 녹아 가"
    }
  ],
